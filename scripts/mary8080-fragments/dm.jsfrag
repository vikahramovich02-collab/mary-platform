    disconnecting&&e.jsxs("div",{role:"alertdialog","aria-modal":!0,"aria-labelledby":"disconnect-title",style:{position:"fixed",inset:0,zIndex:95,display:"flex",alignItems:"center",justifyContent:"center",padding:20,background:"rgba(20,20,28,0.22)"},children:[
      e.jsx("button",{type:"button","aria-label":"Закрыть подтверждение",onClick:()=>setDisconnecting(null),style:{position:"absolute",inset:0,border:"none",background:"transparent"}}),
      e.jsxs("div",{style:{position:"relative",width:"min(430px,100%)",padding:24,borderRadius:20,background:"#fff",border:"1px solid rgba(38,38,51,0.1)",boxShadow:"0 20px 60px rgba(20,20,28,0.18)"},children:[
        e.jsx("div",{id:"disconnect-title",style:{fontSize:20,fontWeight:600,color:k.text},children:`Отключить ${disconnecting.name}?`}),
        e.jsx("div",{style:{marginTop:10,fontSize:14,lineHeight:1.55,color:k.muted},children:`Новые данные перестанут поступать. Процессы «${disconnecting.uses.join("», «")}» могут потребовать участия сотрудника.`}),
        e.jsx("div",{style:{marginTop:12,padding:12,borderRadius:13,background:"rgba(38,38,51,0.04)",fontSize:12.5,lineHeight:1.5,color:k.text},children:"Уже полученная история сохранится. Подключение можно восстановить позже."}),
        e.jsxs("div",{style:{display:"flex",justifyContent:"flex-end",gap:8,marginTop:20},children:[
          e.jsx("button",{type:"button",onClick:()=>setDisconnecting(null),style:{height:38,padding:"0 15px",border:"1px solid rgba(38,38,51,0.1)",borderRadius:999,background:"#fff",color:k.text,fontFamily:"inherit",fontSize:13,cursor:"pointer"},children:"Оставить"}),
          e.jsx("button",{type:"button",onClick:confirmDisconnect,style:{height:38,padding:"0 16px",border:"none",borderRadius:999,background:"#B55252",color:"#fff",fontFamily:"inherit",fontSize:13,fontWeight:550,cursor:"pointer"},children:"Отключить"})
        ]})
      ]})
    ]})
  ]})})
}

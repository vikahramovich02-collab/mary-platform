function homePage({onNavigate:s,onAskMary:d}){
  const[period,setPeriod]=g.useState("Сегодня"),[maryOpen,setMaryOpen]=g.useState(!1),
    decisions=[
      {title:"Подтвердить перенос записи",detail:"Даниела выбрала пятницу, 18:00",time:"2 мин",icon:"/icons/icon_main-7.png"},
      {title:"Проверить оплату",detail:"Деньги списались, заказ не появился · 5 370 ₽",time:"5 мин",icon:"/icons/icon_main-3.png"},
      {title:"Согласовать возврат",detail:"Mary подготовила решение и ответ клиенту",time:"12 мин",icon:"/icons/knowledge/refresh.svg"}
    ],
    go=m=>s&&s(m);
  return e.jsxs("main",{className:"mary-home",children:[
    e.jsx("style",{children:`
      .mary-home{--ink:#252530;--muted:#9494a3;--line:rgba(37,37,48,.105);flex:1;min-width:0;height:100%;overflow:auto;background:#fff;color:var(--ink)}
      .mary-home *{box-sizing:border-box}.mary-home button,.mary-home select{font:inherit}.mary-home button:focus-visible,.mary-home select:focus-visible{outline:2px solid #4f62ff;outline-offset:2px}
      .mary-home-page{max-width:1580px;margin:0 auto;padding:72px 62px 42px}
      .mary-home-head{display:flex;align-items:flex-start;justify-content:space-between;gap:24px}
      .mary-home-title{margin:0;font-size:46px;line-height:1.04;font-weight:560;letter-spacing:-.045em}
      .mary-home-sub{margin:14px 0 0;font-size:19px;line-height:1.45;color:var(--muted)}
      .mary-home-actions{display:flex;align-items:center;gap:16px}
      .mary-home-refresh{width:50px;height:50px;display:grid;place-items:center;border:1px solid var(--line);border-radius:999px;background:#fff;cursor:pointer}
      .mary-home-refresh img{width:19px;height:19px}
      .mary-home-primary{height:50px;padding:0 28px;border:0;border-radius:999px;background:#17171f;color:#fff;font-weight:550;cursor:pointer}
      .mary-home-summary{display:grid;grid-template-columns:repeat(3,1fr);margin-top:96px}
      .mary-home-summary-item{min-height:84px;padding:8px 0 8px 0}
      .mary-home-summary-item+ .mary-home-summary-item{padding-left:94px;border-left:1px solid var(--line)}
      .mary-home-number{font-size:43px;line-height:1;font-weight:480;letter-spacing:-.04em}
      .mary-home-label{margin-top:15px;font-size:18px;color:var(--muted)}
      .mary-home-section{margin-top:82px}
      .mary-home-section-head{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:18px}
      .mary-home-section-title{margin:0;font-size:26px;line-height:1.2;font-weight:560;letter-spacing:-.025em}
      .mary-home-link{display:inline-flex;align-items:center;gap:14px;border:0;background:transparent;color:#8e8ea0;cursor:pointer;font-size:16px}
      .mary-home-link img{width:19px;height:19px;transform:rotate(180deg)}
      .mary-home-decisions{border-top:1px solid var(--line)}
      .mary-home-decision{width:100%;min-height:96px;display:grid;grid-template-columns:58px minmax(220px,.9fr) minmax(360px,1.45fr) 90px 24px;align-items:center;gap:22px;padding:0;border:0;border-bottom:1px solid var(--line);background:#fff;color:var(--ink);text-align:left;cursor:pointer}
      .mary-home-decision:hover{background:#fafafa}
      .mary-home-decision-icon{width:48px;height:48px;display:grid;place-items:center;border:1px solid var(--line);border-radius:12px;background:#fff}
      .mary-home-decision-icon img{width:21px;height:21px;object-fit:contain}
      .mary-home-decision-title{font-size:18px;font-weight:550}
      .mary-home-decision-detail,.mary-home-decision-time{font-size:17px;color:var(--muted)}
      .mary-home-decision-time{white-space:nowrap}
      .mary-home-decision-arrow{width:18px;height:18px;transform:rotate(180deg)}
      .mary-home-results{margin-top:78px;padding-top:48px;border-top:1px solid var(--line)}
      .mary-home-period{height:38px;padding:0 16px;border:1px solid var(--line);border-radius:999px;background:#fff;color:#54545f;cursor:pointer}
      .mary-home-metrics{display:grid;grid-template-columns:repeat(4,1fr);margin-top:36px}
      .mary-home-metric{min-height:98px;padding-right:44px}
      .mary-home-metric+ .mary-home-metric{padding-left:72px;border-left:1px solid var(--line)}
      .mary-home-metric-value{font-size:38px;line-height:1;font-weight:500}
      .mary-home-metric-label{margin-top:12px;font-size:16px;line-height:1.35;color:var(--muted)}
      .mary-home-result-foot{display:flex;align-items:center;justify-content:space-between;gap:18px;min-height:74px;margin-top:12px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);color:var(--muted);font-size:15px}
      .mary-home-status{display:grid;grid-template-columns:270px 1fr auto;align-items:center;gap:20px;min-height:72px;color:var(--muted);font-size:14px}
      .mary-home-health{display:flex;align-items:center;gap:13px;color:#555560}.mary-home-health-dot{width:10px;height:10px;border-radius:999px;background:#9193a7}
      .mary-home-dialog-backdrop{position:fixed;inset:0;z-index:80;display:grid;place-items:center;padding:20px;background:rgba(20,20,28,.25)}
      .mary-home-dialog{width:min(480px,100%);padding:24px;border:1px solid var(--line);border-radius:20px;background:#fff;box-shadow:0 20px 70px rgba(20,20,28,.18)}
      .mary-home-dialog-top{display:flex;align-items:center;justify-content:space-between}.mary-home-dialog h2{margin:0;font-size:22px}.mary-home-dialog p{margin:12px 0 20px;color:var(--muted);font-size:14px;line-height:1.5}
      @media(max-width:1000px){.mary-home-page{padding:42px 32px}.mary-home-summary-item+ .mary-home-summary-item{padding-left:42px}.mary-home-decision{grid-template-columns:50px minmax(180px,.9fr) minmax(240px,1.3fr) 70px 20px}.mary-home-metric+ .mary-home-metric{padding-left:32px}}
      @media(max-width:720px){.mary-home-page{padding:28px 18px 92px}.mary-home-title{font-size:31px}.mary-home-sub{font-size:14px}.mary-home-actions .mary-home-refresh{display:none}.mary-home-primary{height:42px;padding:0 18px;font-size:13px}.mary-home-summary{margin-top:42px}.mary-home-summary-item{min-height:72px}.mary-home-summary-item+ .mary-home-summary-item{padding-left:18px}.mary-home-number{font-size:28px}.mary-home-label{margin-top:10px;font-size:12px}.mary-home-section{margin-top:48px}.mary-home-section-title{font-size:20px}.mary-home-link{font-size:13px}.mary-home-decision{grid-template-columns:44px 1fr 18px;gap:14px;padding:14px 0}.mary-home-decision-detail{grid-column:2;font-size:13px}.mary-home-decision-time{display:none}.mary-home-decision-arrow{grid-column:3;grid-row:1/3}.mary-home-results{margin-top:48px;padding-top:30px}.mary-home-metrics{grid-template-columns:repeat(2,1fr);gap:26px 0}.mary-home-metric{min-height:88px;padding-right:18px}.mary-home-metric+ .mary-home-metric{padding-left:18px}.mary-home-metric:nth-child(3){padding-left:0;border-left:0}.mary-home-result-foot{align-items:flex-start;flex-direction:column;padding:18px 0}.mary-home-status{grid-template-columns:1fr;gap:9px;padding:18px 0}.mary-home-section-head{align-items:flex-start}}
      @media(prefers-reduced-motion:reduce){.mary-home *{transition:none!important}}
    `}),
    e.jsxs("div",{className:"mary-home-page",children:[
      e.jsxs("header",{className:"mary-home-head",children:[e.jsxs("div",{children:[e.jsx("h1",{className:"mary-home-title",children:"Главная"}),e.jsx("p",{className:"mary-home-sub",children:"Всё важное о работе бизнеса и Mary — без лишнего шума"})]}),e.jsxs("div",{className:"mary-home-actions",children:[e.jsx("button",{type:"button",className:"mary-home-refresh","aria-label":"Обновить данные",children:e.jsx("img",{src:"/icons/knowledge/refresh.svg",alt:""})}),e.jsx("button",{type:"button",className:"mary-home-primary",onClick:()=>setMaryOpen(!0),children:"Спросить Mary"})]})]}),
      e.jsxs("section",{className:"mary-home-summary","aria-label":"Краткая сводка",children:[["4","ждут решения"],["18","обращений решено"],["4 ч 20 мин","сэкономлено"]].map((m,h)=>e.jsxs("div",{className:"mary-home-summary-item",children:[e.jsx("div",{className:"mary-home-number",children:m[0]}),e.jsx("div",{className:"mary-home-label",children:m[1]})]},h))}),
      e.jsxs("section",{className:"mary-home-section",children:[e.jsxs("div",{className:"mary-home-section-head",children:[e.jsx("h2",{className:"mary-home-section-title",children:"Требует вашего решения"}),e.jsxs("button",{type:"button",className:"mary-home-link",onClick:()=>go("inbox"),children:["Все решения",e.jsx("img",{src:"/icons/knowledge/back.svg",alt:""})]})]}),e.jsx("div",{className:"mary-home-decisions",children:decisions.map(m=>e.jsxs("button",{type:"button",className:"mary-home-decision",onClick:()=>go("inbox"),children:[e.jsx("span",{className:"mary-home-decision-icon",children:e.jsx("img",{src:m.icon,alt:""})}),e.jsx("span",{className:"mary-home-decision-title",children:m.title}),e.jsx("span",{className:"mary-home-decision-detail",children:m.detail}),e.jsx("span",{className:"mary-home-decision-time",children:m.time}),e.jsx("img",{className:"mary-home-decision-arrow",src:"/icons/knowledge/back.svg",alt:""})]},m.title))})]}),
      e.jsxs("section",{className:"mary-home-results",children:[e.jsxs("div",{className:"mary-home-section-head",children:[e.jsx("h2",{className:"mary-home-section-title",children:"Результат работы Mary"}),e.jsx("select",{className:"mary-home-period",value:period,onChange:m=>setPeriod(m.target.value),"aria-label":"Период",children:["Сегодня","Неделя","Месяц"].map(m=>e.jsx("option",{children:m},m))})]}),e.jsx("div",{className:"mary-home-metrics",children:[["18","обращений решено","без сотрудника"],["3","записи","обновлены"],["5","задач","выполнено"],["2","случая передано","команде"]].map((m,h)=>e.jsxs("div",{className:"mary-home-metric",children:[e.jsx("div",{className:"mary-home-metric-value",children:m[0]}),e.jsxs("div",{className:"mary-home-metric-label",children:[m[1],e.jsx("br",{}),m[2]]})]},h))}),e.jsxs("div",{className:"mary-home-result-foot",children:[e.jsx("span",{children:"Mary сэкономила команде примерно 4 ч 20 мин"}),e.jsxs("button",{type:"button",className:"mary-home-link",onClick:()=>go("analytics"),children:["Открыть аналитику",e.jsx("img",{src:"/icons/knowledge/back.svg",alt:""})]})]}),e.jsxs("div",{className:"mary-home-status",children:[e.jsxs("div",{className:"mary-home-health",children:[e.jsx("span",{className:"mary-home-health-dot"}),e.jsx("span",{children:"Mary работает нормально"})]}),e.jsx("span",{children:"3 сервиса подключено · данные обновлены 2 минуты назад"}),e.jsxs("button",{type:"button",className:"mary-home-link",onClick:()=>go("integrations"),children:["Интеграции",e.jsx("img",{src:"/icons/knowledge/back.svg",alt:""})]})]})]})
    ]}),
    maryOpen&&e.jsx("div",{className:"mary-home-dialog-backdrop",onMouseDown:m=>m.target===m.currentTarget&&setMaryOpen(!1),children:e.jsxs("div",{className:"mary-home-dialog",role:"dialog","aria-modal":"true","aria-labelledby":"mary-home-dialog-title",children:[e.jsxs("div",{className:"mary-home-dialog-top",children:[e.jsx("h2",{id:"mary-home-dialog-title",children:"Спросить Mary"}),e.jsx("button",{type:"button",className:"mary-home-refresh","aria-label":"Закрыть",onClick:()=>setMaryOpen(!1),children:e.jsx("img",{src:"/icons/knowledge/close.svg",alt:""})})]}),e.jsx("p",{children:"Я вижу текущие решения, результаты и состояние подключений. С чего начнём?"}),e.jsx("button",{type:"button",className:"mary-home-primary",onClick:()=>{setMaryOpen(!1);d&&d()},children:"Открыть чат с Mary"})]})})
  ]})
}
